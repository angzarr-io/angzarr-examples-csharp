<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Protobuf" Version="3.25.1" />
        <PackageReference Include="Google.Api.CommonProtos" Version="2.15.0" />
        <PackageReference Include="Grpc.Net.Client" Version="2.60.0" />
        <PackageReference Include="Grpc.Tools" Version="2.60.0" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf
            Include="../angzarr-client-csharp/angzarr/proto/angzarr/*.proto"
            GrpcServices="Both"
            ProtoRoot="../angzarr-client-csharp/angzarr/proto"
        />
        <Protobuf
            Include="../angzarr-project/proto/examples/*.proto"
            GrpcServices="Both"
            ProtoRoot="../angzarr-project/proto"
        />
    </ItemGroup>
</Project>
