<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Angzarr.Proto/Angzarr.Proto.csproj" />
        <ProjectReference Include="../angzarr-client-csharp/Angzarr.Client/Angzarr.Client.csproj" />
        <ProjectReference Include="../Player/Agg/Player.Agg.csproj" />
        <ProjectReference Include="../Table/Agg/Table.Agg.csproj" />
        <ProjectReference Include="../Hand/Agg/Hand.Agg.csproj" />
        <ProjectReference Include="../Hand/GameRules/Hand.GameRules.csproj" />
        <ProjectReference Include="../Tournament/Agg/Tournament.Agg.csproj" />
        <!-- Reservation aggregate hosts orchestration commands (Initiate/Confirm/Release
             for buy-in / rebuy / tournament-registration) that the player.feature
             scenarios exercise via PlayerSteps. -->
        <ProjectReference Include="../Reservation/Agg/Reservation.Agg.csproj" />
        <!-- ReservationPM — the consolidated BuyIn / Rebuy / Registration PM, exercised
             by features/example/unit/process_manager.feature scenarios EU-0421..0440. -->
        <ProjectReference Include="../Reservation/Pmg/Reservation.Pmg.csproj" />
        <!-- Saga projects backing saga.feature (TableSyncStart/Complete, HandPayout,
             HandResults — the feature names map onto these per-direction sagas). -->
        <ProjectReference Include="../Table/SagaHand/Table.SagaHand.csproj" />
        <ProjectReference Include="../Hand/SagaTable/Hand.SagaTable.csproj" />
        <ProjectReference Include="../Hand/SagaPlayer/Hand.SagaPlayer.csproj" />
        <ProjectReference Include="../Table/SagaPlayer/Table.SagaPlayer.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
        <PackageReference Include="NUnit" Version="4.0.1" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
        <PackageReference Include="SpecFlow" Version="3.9.74" />
        <PackageReference Include="SpecFlow.NUnit" Version="3.9.74" />
        <PackageReference Include="SpecFlow.Tools.MsBuild.Generation" Version="3.9.74" />
        <PackageReference Include="FluentAssertions" Version="6.12.0" />
        <PackageReference Include="Grpc.Net.Client" Version="2.60.0" />
    </ItemGroup>

    <ItemGroup>
        <SpecFlowFeatureFiles Include="../features/**/*.feature" />
        <None
            Include="../features/**/*.feature"
            Link="Features/%(RecursiveDir)%(FileName)%(Extension)"
        />
        <Compile
            Include="../features/**/*.feature.cs"
            Link="Features/%(RecursiveDir)%(FileName)%(Extension)"
        />
    </ItemGroup>
</Project>
