# C# poker examples - container version
# This file is mounted as 'justfile' inside the container
# Also used directly in CI container jobs

set shell := ["bash", "-c"]

ROOT := `git rev-parse --show-toplevel`
SLN := "Angzarr.Examples.sln"

default:
    @just --list

# Proto regen executor. Invokes `buf generate` which emits *.cs into
# Angzarr.Proto/Generated/ per buf.gen.yaml. See the host justfile's
# `generate-proto` orchestration for the mtime-guarded entry point.
# Per project_proto_generation_model `buf generate` is the EXECUTOR and
# `just` owns the trigger; downstream `dotnet build` consumes pre-emitted
# .cs files via the default SDK Compile glob (no Grpc.Tools / protoc
# transitive regen).
generate-proto-force:
    buf generate

# Legacy aliases.
proto-gen: generate-proto-force
proto: generate-proto-force

# NOTE: proto regen is NOT a recipe dep here — it runs once on the host
# (via the host justfile's `generate-proto` mtime-guarded entry point)
# BEFORE the container is started. Inside the container we consume the
# pre-emitted Angzarr.Proto/Generated/*.cs. Re-running buf inside the
# container would be wasted work and would require buf in PATH.

restore:
    dotnet restore {{SLN}}

build: restore
    dotnet build {{SLN}} --configuration Release --no-restore

build-dev: restore
    dotnet build {{SLN}} --configuration Debug --no-restore

test-unit: build
    dotnet test {{SLN}} --configuration Release --no-build --verbosity normal --filter "TestCategory!=Acceptance&TestCategory!=e2e&TestCategory!=sync-mode&TestCategory!=cascade-error"

test-acceptance: build
    PLAYER_URL="${PLAYER_URL:-http://localhost:1310}" dotnet test {{SLN}} --configuration Release --no-build --verbosity normal --filter "TestCategory=Acceptance|TestCategory=e2e"

test: build
    dotnet test {{SLN}} --configuration Release --no-build --verbosity normal

fmt:
    dotnet format {{SLN}}

# Run Stryker.NET mutation testing on tournament handlers
mutation-test: build
    dotnet tool restore
    dotnet stryker --config-file stryker-config.json

lint: build
    dotnet build {{SLN}} --configuration Release --no-restore /p:TreatWarningsAsErrors=true

# Auto-format code (dotnet format)
fmt-fix:
    dotnet format
